# ================================================================
# .env.example — copy this file to .env and fill in real values.
# ================================================================
# .env itself is gitignored and should NEVER be committed — that's
# the whole point of it. This example file has no real secrets in
# it, so it's safe to commit and share.
#
# Everything below is OPTIONAL. Leave anything blank and the site
# automatically falls back to demo/local behavior for that piece —
# see config.js for exactly what each fallback does.
# ================================================================

PORT=3000

# Change this before putting the site online — protects /admin
ADMIN_PASSWORD=changeme123

# Shows OTPs on screen for testing. Set to false once real OTP
# delivery (MSG91 below) is configured and working.
DEMO_MODE=true

# ---------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---------------------------------------------------------------
# OTP DELIVERY (optional) — Meta WhatsApp API, AiSensy, MSG91
# ---------------------------------------------------------------
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_TEMPLATE_NAME=otp_auth

AISENSY_API_KEY=
AISENSY_OTP_TEMPLATE=
MSG91_AUTHKEY=
MSG91_OTP_TEMPLATE_ID=

# ---------------------------------------------------------------
# PAYMENTS (optional) — Razorpay
# ---------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
